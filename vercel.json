{
  "rewrites": [
    {
      "source": "/s/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/t/:id",
      "destination": "/api/thread?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "api/{_fonts,_assets}/**"
    }
  }
}
