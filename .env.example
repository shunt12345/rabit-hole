# Client-safe values only — these get bundled into the built app. The real
# Anthropic key is a Supabase secret on the rabbit-hole-proxy function, never
# an env var here. See README.md for full setup.

VITE_SUPABASE_URL=https://gflcioanuzrxgxxafnzl.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
# Stripe's PUBLISHABLE key (starts pk_...), not the secret key — that one's
# a Supabase secret on create-checkout-session/stripe-webhook, never here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
